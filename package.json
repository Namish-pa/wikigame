{
  "name": "wikipedia-race-game",
  "version": "1.0.0",
  "description": "Multiplayer Wikipedia Race Game",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --include=dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run install:all && npm run build:client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
